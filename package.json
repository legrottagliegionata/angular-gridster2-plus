{
  "name": "angular-gridster2",
  "version": "22.0.0",
  "license": "MIT",
  "scripts": {
    "husky": "husky",
    "commitlint": "commitlint",
    "lint-staged": "lint-staged",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-lib": "ng build angular-gridster2 && cp LICENSE dist/angular-gridster2 && cp README.md dist/angular-gridster2",
    "test": "ng test",
    "test-lib": "ng test angular-gridster2",
    "lint": "ng lint",
    "watch": "ng build --watch --configuration development",
    "deploy": "ng deploy",
    "prepare": "husky"
  },
  "homepage": "https://tiberiuzuld.github.io/angular-gridster2",
  "bugs": {
    "url": "https://github.com/tiberiuzuld/angular-gridster2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiberiuzuld/angular-gridster2.git"
  },
  "description": "Angular gridster 2",
  "keywords": [
    "angular",
    "angular2",
    "typescript",
    "dashboard",
    "gridster",
    "gridster2",
    "resize",
    "drag&drop",
    "widgets"
  ],
  "authors": [
    "Tiberiu Zuld"
  ],
  "files": [
    "dist/*"
  ],
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/material": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "marked": "18.0.13",
    "ngx-markdown": "22.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.1",
    "angular-cli-ghpages": "3.1.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.11"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{html,scss,js,ts,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
